{
  "manifest_version": 3,
  "name": "淘宝购物车价格导出（本地只读）",
  "version": "1.0.0",
  "description": "从已登录的淘宝购物车或结算页导出页面可见的商品、优惠及价格信息。",
  "permissions": ["downloads"],
  "content_scripts": [
    {
      "matches": ["https://*.taobao.com/*", "https://*.tmall.com/*"],
      "js": ["offers.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
